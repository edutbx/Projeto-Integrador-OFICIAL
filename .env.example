# =========================================
# Projeto Integrador - Example Environment
# =========================================
# Copy this file to .env and fill in the values.
# Keep secrets out of version control.

# -----------------------------------------
# Frontend (React)
# -----------------------------------------
# Used by Google GenAI integration in the UI.
VITE_GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------
# Python IA integration (FastAPI)
# -----------------------------------------
# StackSpot authentication realm.
STACKSPOT_REALM=your-stackspot-realm

# StackSpot OAuth client id.
STACKSPOT_CLIENT_ID=your-stackspot-client-id

# StackSpot OAuth client secret.
STACKSPOT_CLIENT_KEY=your-stackspot-client-secret

# StackSpot agent endpoint used by /chat.
STACKSPOT_AGENT_URL=https://genai-inference-app.stackspot.com/v1/agent/your-agent-id/chat

# -----------------------------------------
# Backend Java (Spring Boot)
# -----------------------------------------
# The current application.properties uses local defaults.
# Uncomment and wire these values into Spring if you want to externalize them later.
# SPRING_APPLICATION_NAME=Saude
# SERVER_PORT=5000
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/saude
# VIACEP_BASE_URL=https://viacep.com.br/ws
